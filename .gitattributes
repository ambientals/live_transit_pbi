# Normalize line endings: store & check out text as LF everywhere.
# Local dev is Windows (CRLF), CI is Linux (LF). Pinning to LF keeps files
# byte-identical across environments and avoids the CRLF/LF "flip-flop".

* text=auto

*.py    text eol=lf
*.csv   text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.tmdl  text eol=lf
*.pbip  text eol=lf
*.pbir  text eol=lf
*.pbism text eol=lf
